cmd - 1 : yabai -m space --focus 1
cmd - 2 : yabai -m space --focus 2
cmd - 3 : yabai -m space --focus 3
cmd - 4 : yabai -m space --focus 4
cmd - 5 : yabai -m space --focus 5
cmd - 6 : yabai -m space --focus 6

cmd - return : osascript -e 'tell application "Ghostty" to new window activate'

cmd + shift - return : osascript -e 'tell application "Safari.app" to make new document activate'
cmd + shift - b : osascript -e 'tell application "Safari.app" to make new document activate'
cmd + shift - c : open -a Calendar
cmd + shift - e : open -a Mail
cmd + shift - f : open -a Finder
cmd + shift - m : open -a Music
cmd + shift - n : open -a 'Visual Studio Code'
cmd + shift - p : open -a Photos
cmd + shift - s : open -a Maps
cmd + shift - x : open -a X
cmd + shift - y : open -a YouTube

ctrl + cmd - k : env -u SHELL kitty --single-instance --directory="${HOME}"
ctrl + cmd - t : osascript -e 'tell application "Ghostty" to new window activate'
ctrl + cmd - j : alacritty msg create-window || env -u SHELL alacritty
#ctrl + cmd - t : osascript -e 'tell application "iTerm" to create window with default profile' \
#    -e 'activate application "iTerm"'
ctrl + cmd - e : open -a "Microsoft Edge.app" -n
#ctrl + cmd - g : open -a "Google Chrome.app" -n
ctrl + cmd - g : osascript -e 'tell application "Safari.app" to make new document activate'
ctrl + cmd - s : osascript -e 'tell application "Safari.app" to make new document activate'
ctrl + cmd - m : open -a "Mail.app"
